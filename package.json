{
  "name": "open-oscar-client-kit",
  "version": "0.1.2",
  "description": "OSCAR for Node: a client, its wire codec and model, a test server and a test suite for ports.",
  "license": "MIT",
  "author": "Lucas Chumley",
  "repository": { "type": "git", "url": "git+https://github.com/ukozi/open-oscar-client-kit.git" },
  "type": "module",
  "engines": { "node": ">=22.12" },
  "packageManager": "pnpm@10.7.1",
  "exports": {
    ".": { "types": "./dist/lib/index.d.ts", "default": "./dist/lib/index.js" },
    "./wire": { "types": "./dist/src/wire/index.d.ts", "default": "./dist/src/wire/index.js" },
    "./client": { "types": "./dist/src/client/index.d.ts", "default": "./dist/src/client/index.js" },
    "./model": { "types": "./dist/src/model/index.d.ts", "default": "./dist/src/model/index.js" },
    "./testing": { "types": "./dist/test/fake/index.d.ts", "default": "./dist/test/fake/index.js" }
  },
  "bin": { "open-oscar-client-kit": "./dist/lib/cli/main.js" },
  "files": ["dist", "docs", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.model.json",
    "lint": "biome lint .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R test/vectors dist/test/vectors",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "docs:api": "typedoc",
    "prepack": "pnpm build && pnpm docs:api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.19.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
